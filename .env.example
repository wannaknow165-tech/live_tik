# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TIKLEAP_API_KEY: Optional API key for TikLeap regional TikTok LIVE creator rankings (https://api.tikleap.com).
TIKLEAP_API_KEY="MY_TIKLEAP_API_KEY"

# TIKTOK_CLIENT_KEY & TIKTOK_CLIENT_SECRET: Optional TikTok Login Kit v2 OAuth credentials (https://developers.tiktok.com).
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"

# Optional TikTok LIVE Session Cookies for 6 Moderator Accounts (enables direct server-side sendMessage to TikTok LIVE rooms):
TIKTOK_MOD_1_SESSIONID=""
TIKTOK_MOD_1_TARGET_IDC="useast2a"
TIKTOK_MOD_2_SESSIONID=""
TIKTOK_MOD_2_TARGET_IDC="useast2a"
TIKTOK_MOD_3_SESSIONID=""
TIKTOK_MOD_3_TARGET_IDC="useast2a"
TIKTOK_MOD_4_SESSIONID=""
TIKTOK_MOD_4_TARGET_IDC="useast2a"
TIKTOK_MOD_5_SESSIONID=""
TIKTOK_MOD_5_TARGET_IDC="useast2a"
TIKTOK_MOD_6_SESSIONID=""
TIKTOK_MOD_6_TARGET_IDC="useast2a"
