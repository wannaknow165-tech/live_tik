# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: המפתח היחיד הנדרש למוח המרכזי של BOOSTERA (OpenAI + Claude + Gemini + מודל מהיר + תמלול + Embeddings).
# כל שאר השדות (מודלים ותקרות תקציב) מוגדרים אוטומטית עם ברירות מחדל מאומתות מול קטלוג OpenRouter וניתנים לשינוי בכל עת מתוך הדשבורד.
# המפתח נקרא בשרת בלבד ולעולם אינו נחשף לדפדפן או ללוגים.
OPENROUTER_API_KEY=""

# Optional server overrides (auto-configured automatically if left unset; editable live inside the Dashboard):
# OPENROUTER_OPENAI_MODEL="openai/gpt-5.4"
# OPENROUTER_OPENAI_FALLBACK_MODEL="openai/gpt-4.1-mini"
# OPENROUTER_CLAUDE_MODEL="anthropic/claude-sonnet-5"
# OPENROUTER_CLAUDE_FALLBACK_MODEL="anthropic/claude-haiku-4.5"
# OPENROUTER_GEMINI_MODEL="google/gemini-3.8-flash"
# OPENROUTER_GEMINI_FALLBACK_MODEL="google/gemini-2.5-flash"
# OPENROUTER_FAST_MODEL="openai/gpt-5-nano"
# OPENROUTER_STT_MODEL="google/gemini-2.5-flash"
# OPENROUTER_STT_FALLBACK_MODEL="openai/gpt-audio-mini"
# OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
# OPENROUTER_EMBEDDING_FALLBACK_MODEL="google/gemini-embedding-001"
# OPENROUTER_DAILY_BUDGET_USD="5.00"
# OPENROUTER_MONTHLY_BUDGET_USD="50.00"
# OPENROUTER_ZDR_ENABLED="true"


# TIKLEAP_API_KEY: Optional API key for TikLeap regional TikTok LIVE creator rankings (https://api.tikleap.com).
TIKLEAP_API_KEY="MY_TIKLEAP_API_KEY"

# TIKTOK_CLIENT_KEY & TIKTOK_CLIENT_SECRET: Optional TikTok Login Kit v2 OAuth credentials (https://developers.tiktok.com).
# Optional — does not block BOOSTERA. Session tokens are managed automatically and securely on the server after authorized OAuth sign-in.
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""

# GEELARK_API_TOKEN (or GEELARK_APP_ID + GEELARK_API_KEY): Optional credentials for existing GeeLark Cloud Phones (https://openapi.geelark.com).
# Optional — does not block BOOSTERA. Enables verifying and controlling TikTok accounts directly on your existing cloud phones without manual SESSION/TARGET fields.
# GEELARK_API_TOKEN=""
# GEELARK_APP_ID=""
# GEELARK_API_KEY=""

