# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TIKLEAP_API_KEY: Optional API key for TikLeap regional TikTok LIVE creator rankings (https://api.tikleap.com).
TIKLEAP_API_KEY="MY_TIKLEAP_API_KEY"

# TIKTOK_CLIENT_KEY & TIKTOK_CLIENT_SECRET: Optional TikTok Login Kit v2 OAuth credentials (https://developers.tiktok.com).
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"

# Smart Alpha Director: on by default ONLY on the active, verified mirrored TikTok LIVE.
# Existing AI autopilot toggle in the dashboard also controls it. It never sends chat.
# Gemini requests on manual analysis remain available even when auto mode below is 0.
BOOSTERA_GEMINI_AUTORUN="0"
# Set to 1 to allow the legacy show's ongoing autonomous Gemini calls (may incur costs).

BOOSTERA_GLOBAL_SCOUT_AUTORUN="0"
# Set to 1 to let the server seek unrelated global LIVE creators on boot.

# Optional local server hardening for a standalone Windows installation:
# BOOSTERA_BIND_HOST="127.0.0.1"
# For Cloud Run / hosted environments bind to 0.0.0.0 behind an authenticated gateway.
