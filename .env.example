# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# TIKLEAP_API_KEY: Optional API key for TikLeap regional TikTok LIVE creator rankings (https://api.tikleap.com).
TIKLEAP_API_KEY="MY_TIKLEAP_API_KEY"

# TIKTOK_CLIENT_KEY & TIKTOK_CLIENT_SECRET: Optional TikTok Login Kit v2 OAuth credentials (https://developers.tiktok.com).
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"
